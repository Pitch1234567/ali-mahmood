# Public site identity
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-username
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-profile

# Server-only contact delivery through Resend
RESEND_API_KEY=re_your_api_key
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=Ali Mahmood Portfolio <portfolio@your-domain.example>
CONTACT_ALLOWED_ORIGIN=https://your-domain.example

# Optional concept-project destinations. Leave blank to hide the action.
NEXT_PUBLIC_SERVICESPARK_GITHUB_URL=
NEXT_PUBLIC_SERVICESPARK_LIVE_URL=
NEXT_PUBLIC_FOCUSFLOW_GITHUB_URL=
NEXT_PUBLIC_FOCUSFLOW_LIVE_URL=
NEXT_PUBLIC_TABLEREADY_GITHUB_URL=
NEXT_PUBLIC_TABLEREADY_LIVE_URL=
